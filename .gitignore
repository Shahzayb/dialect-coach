.DS_Store
guides/
playground/

# Local notes that stay out of git
plans/master-plan.md

# Python
.venv/
__pycache__/
*.py[cod]

# Secrets and local state
.env
.streamlit/secrets.toml
.usage.json

# Local state: the SQLite database and the synthesised-audio cache both live here. The
# cache holds neural-voice renderings of dictionary words — no personal data, which is why
# caching it does not touch the no-stored-audio rule (that rule covers YOUR recordings, and
# nothing ever writes one of those to disk).
data/

# Local SQLite database, including WAL sidecar files. A committed database is a leaked one
# the moment it holds anything real.
*.db
*.db-wal
*.db-shm
*.sqlite3

# Recordings. The rhythm baseline's WAV lives here so the passage can be re-assessed
# without paying for synthesis again; the assessment JSON it produces IS committed, under
# tests/fixtures/. Audio never is.
audio/
