{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "coach",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "up",
        "--build"
      ],
      "port": 8501
    },
    {
      "name": "coach-offline",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "run",
        "--rm",
        "--service-ports",
        "-e",
        "OFFLINE_MODE=true",
        "-e",
        "DB_PATH=data/offline_check.db",
        "app",
        "streamlit",
        "run",
        "src/app.py",
        "--server.port=8501",
        "--server.address=0.0.0.0",
        "--server.headless=true"
      ],
      "port": 8501
    }
  ]
}
