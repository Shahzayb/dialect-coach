{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "coach",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 8501
    },
    {
      "name": "coach-seeded-demo",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose", "run", "--rm", "--service-ports",
        "-e", "DB_PATH=data/seed_demo.db",
        "-e", "OFFLINE_MODE=true",
        "app",
        "streamlit", "run", "src/app.py",
        "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"
      ],
      "port": 8501
    }
  ]
}
