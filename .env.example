# Copy to .env for local development. .env is gitignored — never commit real values.
# On Hugging Face Spaces these are set as Space secrets/variables instead of a file.
#
# Resolution order is os.environ, then st.secrets, then this file. Settings marked
# "not read yet" belong to work that has not landed; everything else is live.

# --- Required secrets ------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Not read yet — coaching is a later chunk.
GEMINI_API_KEY=

# --- Optional overrides ----------------------------------------------------------------
# Model ID is read from the environment so it can be swapped without a code change.
GEMINI_MODEL=
# en-US neural voice used for "Hear it" playback. Defaults to en-US-AvaNeural.
# TTS is a separate free bucket from speech-to-text: 0.5 M characters a month, which at a
# few words per click is effectively unlimited.
AZURE_TTS_VOICE=

# --- Local history ----------------------------------------------------------------------
# SQLite file holding one row per attempt, with both raw API responses stored verbatim and
# no audio. The usage meter below is derived from this table, which is why there is no
# separate .usage.json — one store cannot disagree with itself.
DB_PATH=./data/coach.db

# --- Duration guards (seconds) ---------------------------------------------------------
# Azure returns confusing errors on near-silent or sub-second audio.
MIN_DURATION_SECONDS=1.5
# Per-mode maximums: A drill / B paragraph / C unscripted.
MAX_DURATION_SECONDS_DRILL=30
MAX_DURATION_SECONDS_PARAGRAPH=120
MAX_DURATION_SECONDS_UNSCRIPTED=300

# Not read yet — Mode C is not implemented.
# Mode C: run standard STT first, then scripted assessment against that transcript.
# Doubles audio-hour consumption for the recording, but phoneme diagnosis is worthless
# if the transcript is wrong. Default on.
UNSCRIPTED_TWO_PASS=true

# --- Budget guard ----------------------------------------------------------------------
# The real $0 guarantee is at the account layer (an Azure F0 resource and a Gemini key on
# a project with no billing account cannot bill). This guard is a second line of defence
# against your own misconfiguration, nothing more.
MONTHLY_BUDGET_USD=0.00

# Required to be true while MONTHLY_BUDGET_USD is 0.00: the SDK cannot read the resource
# SKU, so an explicit human acknowledgement that the Speech resource is F0 (not S0) is the
# only available check.
AZURE_TIER_CONFIRMED_F0=false

# true = replay the committed test fixture, no network calls at all. The zero-cost path
# for UI work and tests.
OFFLINE_MODE=false

# Free allowances (F0) — verify against current Azure docs before trusting.
AZURE_FREE_STT_SECONDS=18000
AZURE_FREE_TTS_CHARS=500000

# Overage rates, only used once the free allowance is gone.
AZURE_STT_USD_PER_HOUR=1.00
AZURE_PRON_ADDON_USD_PER_HOUR=0.30
AZURE_TTS_USD_PER_MILLION_CHARS=16.00
GEMINI_USD_PER_MTOK_IN=0.00
GEMINI_USD_PER_MTOK_OUT=0.00
